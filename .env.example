# Local development defaults — fictional data only
DATABASE_URL=mysql://nidan:nidan-local-only@localhost:3306/nidan
API_PORT=8787
SESSION_COOKIE_NAME=nidan_session
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PUBLIC_HTTPS=false
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_CSP_CONNECT_ORIGINS=
TRUST_PROXY=false
REQUIRE_ORGANIZATION=false
PRODUCTION_HARDENING=false
NIDAN_STORAGE_BACKEND=local
PRIVATE_UPLOAD_DIR=./private-uploads
MAX_UPLOAD_MB=10
CLAMAV_SCAN=off
RETENTION_DAYS=365

# AI is disabled by default. Keep provider keys server-only.
NIDAN_AI_PROVIDER=none
NIDAN_AI_BASE_URL=http://127.0.0.1:11434
NIDAN_AI_MODEL=
NIDAN_AI_ALLOW_REMOTE=false
GEMINI_API_KEY=

# Optional local adapters; leave disabled unless separately installed and tested.
AI4BHARAT_ASR_URL=http://127.0.0.1:8090/transcribe
AI4BHARAT_OCR_URL=http://127.0.0.1:8091/ocr
AI4BHARAT_ALLOW_REMOTE=false
VITE_AI4BHARAT_ASR=false
VITE_AI4BHARAT_OCR=false

# Optional BHASHINI/ULCA integration; credentials must never be committed.
BHASHINI_ENABLED=false
BHASHINI_USER_ID=
BHASHINI_API_KEY=
VITE_BHASHINI_ASR=false
VITE_BHASHINI_TTS=false
