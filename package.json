{
  "name": "nidan-patient-first-intake",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12 <23 || >=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "api:dev": "tsx watch server/api/index.ts",
    "dev:full": "concurrently -k -n api,web -c cyan,green \"npm:api:dev\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "api:build": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run api:build",
    "start": "node dist-server/server/api/index.js",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "organization:create": "tsx scripts/create-organization.ts",
    "doctor:create": "tsx scripts/create-doctor.ts",
    "staff:create": "tsx scripts/create-staff.ts",
    "account:reset": "tsx scripts/reset-account.ts",
    "retention:purge": "tsx scripts/purge-retention.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:restore": "tsx scripts/backup.ts restore",
    "backup:verify": "tsx scripts/backup.ts verify",
    "localization:source": "tsx scripts/build-localization-source.ts",
    "localization:merge": "tsx scripts/merge-localizations.ts",
    "languages:validate": "tsx scripts/validate-languages.ts",
    "test": "vitest run",
    "test:api": "vitest run server/api",
    "test:integration": "vitest run server/api/persistence.test.ts --reporter=verbose",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "review-sheet": "tsx scripts/review-sheet.ts",
    "translation-sheet": "tsx scripts/translation-sheet.ts",
    "import-translations": "tsx scripts/import-translations.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "@tesseract.js-data/mar": "^1.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  }
}
